4. Richest Customer Wealth (LeetCode 1672)


Java Code
class Solution {
    public int maximumWealth(int[][] accounts) {

        int max = 0;

        for (int i = 0; i < accounts.length; i++) {

            int sum = 0;

            for (int j = 0; j < accounts[i].length; j++) {
                sum += accounts[i][j];
            }

            if (sum > max)
                max = sum;
        }

        return max;
    }
}

