3. Java Program to Print the Multiplication Table


import java.util.Scanner;

public class MultiplicationTable {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a number: ");
        int n = sc.nextInt();

        System.out.println("Multiplication Table of " + n);

        for (int i = 1; i <= 10; i++) {
            System.out.println(n + " x " + i + " = " + (n * i));
        }

        sc.close();
    }
}


4. Java Program to Find HCF and LCM of Two Numbers


import java.util.Scanner;

public class HCFLCM {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter first number: ");
        int a = sc.nextInt();

        System.out.print("Enter second number: ");
        int b = sc.nextInt();

        int x = a;
        int y = b;

        while (y != 0) {
            int temp = y;
            y = x % y;
            x = temp;
        }

        int hcf = x;
        int lcm = (a * b) / hcf;

        System.out.println("HCF = " + hcf);
        System.out.println("LCM = " + lcm);

        sc.close();
    }
}


5. Java Program to Keep Taking Numbers Until the User Enters 'x' and Print the Sum


import java.util.Scanner;

public class SumUntilX {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int sum = 0;

        while (true) {
            System.out.print("Enter a number (or x to stop): ");

            if (sc.hasNextInt()) {
                sum += sc.nextInt();
            } else {
                String input = sc.next();
                if (input.equalsIgnoreCase("x")) {
                    break;
                } else {
                    System.out.println("Invalid input!");
                }
            }
        }

        System.out.println("Sum = " + sum);

        sc.close();
    }
}
