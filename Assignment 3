52. Sum of Negative Numbers, Positive Even Numbers, and Positive Odd Numbers


import java.util.Scanner;

public class SumCategories {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int num;
        int negativeSum = 0;
        int positiveEvenSum = 0;
        int positiveOddSum = 0;

        while (true) {
            System.out.print("Enter Number (0 to stop): ");
            num = sc.nextInt();

            if (num == 0)
                break;

            if (num < 0)
                negativeSum += num;
            else if (num % 2 == 0)
                positiveEvenSum += num;
            else
                positiveOddSum += num;
        }

        System.out.println("Sum of Negative Numbers = " + negativeSum);
        System.out.println("Sum of Positive Even Numbers = " + positiveEvenSum);
        System.out.println("Sum of Positive Odd Numbers = " + positiveOddSum);
    }
}
