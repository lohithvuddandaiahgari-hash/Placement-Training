12. Check Pythagorean Triplet


import java.util.Scanner;

public class PythagoreanTriplet {

    static boolean isPythagorean(int a, int b, int c) {

        return (a * a + b * b == c * c) ||
               (a * a + c * c == b * b) ||
               (b * b + c * c == a * a);
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter Three Numbers: ");

        int a = sc.nextInt();
        int b = sc.nextInt();
        int c = sc.nextInt();

        if (isPythagorean(a, b, c))
            System.out.println("Pythagorean Triplet");
        else
            System.out.println("Not a Pythagorean Triplet");
    }
}


13. Print Prime Numbers Between Two Numbers


import java.util.Scanner;

public class PrimeRange {

    static boolean isPrime(int n) {

        if (n <= 1)
            return false;

        for (int i = 2; i <= Math.sqrt(n); i++) {
            if (n % i == 0)
                return false;
        }

        return true;
    }

    static void printPrime(int start, int end) {

        for (int i = start; i <= end; i++) {
            if (isPrime(i))
                System.out.print(i + " ");
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter Starting Number: ");
        int start = sc.nextInt();

        System.out.print("Enter Ending Number: ");
        int end = sc.nextInt();

        System.out.println("Prime Numbers:");

        printPrime(start, end);
    }
}


14. Sum of First N Natural Numbers


import java.util.Scanner;

public class NaturalSum {

    static int sumNatural(int n) {

        int sum = 0;

        for (int i = 1; i <= n; i++) {
            sum += i;
        }

        return sum;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter N: ");
        int n = sc.nextInt();

        System.out.println("Sum = " + sumNatural(n));
    }
}
